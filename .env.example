# ==============================================================================
# Altostrat Singapore — HR Agentic Assistant (MVP 1) Environment Configuration
# Copy this file to `.env` and populate your Personal Access Token (`MCP_TOKEN`).
# ==============================================================================

# 1. Google Cloud & Vertex AI RAG Engine Configuration
GOOGLE_CLOUD_PROJECT=ai-training-van-01
GOOGLE_CLOUD_LOCATION=asia-southeast1
VERTEX_RAG_CORPUS_ID=4611686018427387904
USE_CLOUD_RAG=true

# 2. Vendor MCP Server Integration (WorkWeek HCM & ServiceImmediately ITSM)
# Docs: https://mock-saas.aishprabhat.demo.altostrat.com/docs
# ReDoc: https://mock-saas.aishprabhat.demo.altostrat.com/redoc
MCP_SERVER_BASE_URL=https://mock-saas.aishprabhat.demo.altostrat.com
WORKWEEK_MCP_URL=https://mock-saas.aishprabhat.demo.altostrat.com/work-week/mcp/
SERVICE_IMMEDIATELY_MCP_URL=https://mock-saas.aishprabhat.demo.altostrat.com/service-immediately/mcp/
MCP_TOKEN=your_mcp_personal_access_token_here
MCP_AUTHENTICATED_EMPLOYEE_ID=EMP-836
USE_LIVE_MCP=true

# 3. GCP Cloud Firestore (Audit Logging, Transaction Ledger & FAQ Cache)
USE_FIRESTORE=true
FIRESTORE_DATABASE=hr-agent-transaction-ledger
FIRESTORE_LOCATION=asia-southeast1

