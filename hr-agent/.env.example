# Altostrat HR agent — local development configuration (NO SECRETS HERE).
# Copy to `.env` and fill in. In the cloud these come from `agents-cli deploy
# --update-env-vars/--secrets` and Terraform (deployment/terraform).

# --- Model (Vertex AI) -------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
HR_DEFAULT_MODEL=gemini-3.8-flash
# Per-agent overrides (eval experiment: tier orchestrator/policy up)
# HR_ORCHESTRATOR_MODEL=
# HR_POLICY_MODEL=
# HR_WORKWEEK_MODEL=
# HR_ITSM_MODEL=
MAX_LLM_CALLS_PER_TURN=25

# --- Identity ----------------------------------------------------------------
# With a single shared PAT the vendor resolves ONE persona; this must match it.
DEMO_EMPLOYEE_ID=EMP-829

# --- Vendor MCP backends (WorkWeek + ServiceImmediately) ---------------------
# inprocess = seeded mock (tests/eval); mcp = real vendor over MCP (X-MCP-Token)
BACKEND_MODE=inprocess
BACKEND_BASE_URL=https://mock-saas.example.com
BACKEND_TOKEN_LABEL=HR-Group2
# SECRET — set only in your local .env / Secret Manager `workweek-si-pat`:
BACKEND_SHARED_TOKEN=
# Optional per-persona PATs: {"EMP001":"...","EMP002":"..."}
BACKEND_TOKENS_JSON=

# --- Integration plane (hr-acl) ----------------------------------------------
# inprocess = ACL runs inside the agent; remote = call the hr-acl Cloud Run service
INTEGRATION_MODE=inprocess
ACL_URL=
# SECRET in the cloud (Secret Manager `hr-identity-envelope-key`), shared agent <-> hr-acl
IDENTITY_ENVELOPE_SECRET=local-dev-envelope-secret
CONFIRM_TOKEN_TTL_SECONDS=900

# --- State & audit -----------------------------------------------------------
LEDGER_BACKEND=sqlite          # sqlite | firestore
FIRESTORE_DATABASE=(default)
AUDIT_SINK=file                # file | stdout | both  (stdout -> Cloud Logging -> BigQuery)
# HR_RUNTIME_DIR=artifacts/runtime

# --- Guardrails --------------------------------------------------------------
GUARDRAIL_MODE=enforce         # enforce | inspect (shadow)
MODEL_ARMOR_LOCATION=asia-southeast1
# MODEL_ARMOR_TEMPLATE_ID_INPUT=hr-input
# MODEL_ARMOR_TEMPLATE_ID_OUTPUT=hr-output

# --- Retrieval / determinism -------------------------------------------------
RETRIEVAL_TOP_K=5
# HR_FIXED_TODAY=2026-10-05    # pin the clock for eval

# --- Grounding: Vertex AI RAG Engine (SDD D3; asia-southeast1 for CON-5) -----
# Empty RAG_CORPUS = offline BM25 retriever (tests / eval / local dev).
# Populated by `make rag-sync` (writes rag_corpus into terraform.tfvars).
RAG_CORPUS=
RAG_LOCATION=asia-southeast1
RAG_DISTANCE_THRESHOLD=0.6
# POLICY_CORPUS_BUCKET=<project>-hr-policy-corpus

# --- How these map in the cloud (deployment/terraform/cloud_run.tf) ------------
# Terraform vars     : project_id, model_location, default_model, backend_base_url,
#                      demo_employee_id, persona_map, guardrail_mode, rag_corpus
# Secret Manager     : BACKEND_SHARED_TOKEN -> workweek-si-pat (pushed from this .env
#                      by `make push-secrets`), BACKEND_TOKENS_JSON -> hr-backend-tokens,
#                      IDENTITY_ENVELOPE_SECRET -> hr-identity-envelope-key,
#                      CONFIRM_TOKEN_SECRET -> hr-confirm-token-key (generated)
# Fixed in cloud     : INTEGRATION_MODE=remote, BACKEND_MODE=mcp, LEDGER_BACKEND=firestore,
#                      AUDIT_SINK=stdout, UI_DEV_PERSONAS=0

# Vendor profile has no location_status; empty = equipment requests fail closed (SDD §5.4)
VENDOR_DEFAULT_LOCATION_STATUS=
